APP_ENV=development
PORT=4000
# Only trusted reverse-proxy IPs/CIDRs; do not use a global true trust setting.
TRUSTED_PROXY_IPS=

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=your_secure_password
DB_DATABASE=mspaces_db
DB_SSL=false
# Optional custom certificate authority bundle for verified PostgreSQL TLS.
DB_SSL_CA_PATH=
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Account creation, password recovery and security email (SMTP).
# Leave SMTP_HOST blank to disable email while retaining other application features.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=https://your-hris-domain.example
TEMPORARY_PASSWORD_TTL_HOURS=24

# Required in production: generate with openssl rand -base64 48; keep stable across API instances.
SESSION_SIGNING_SECRET=

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES=7d

REDIS_HOST=localhost
REDIS_PORT=6379

# Explicit opt-in only. Actor must be an active HR/Admin user with valid scope.

# Leave annual/onboarding allocation: opt in only after HR approves policies.
LEAVE_ALLOCATION_SCHEDULER_ENABLED=false
LEAVE_ALLOCATION_ACTOR_ID=

# Manual reservation payments: generate a stable secret of at least 32 random characters.
PAYMENT_ACCESS_SECRET=
CLIENT_BOOKING_URL=http://localhost:3005
PAYMENT_PROOF_MAX_MB=5
